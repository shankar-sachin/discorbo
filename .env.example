# Discord Bot Configuration
# Copy this file to .env and fill in your actual values

# Your bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Your application/client ID from the Discord Developer Portal
CLIENT_ID=your_client_id_here

# Your development server ID (for testing commands - optional)
GUILD_ID=your_guild_id_here

# Your Discord user ID (for owner-only commands - optional)
OWNER_ID=your_user_id_here

# AI Chat Configuration (optional but recommended for AI features)
# Get your API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# AI Chat Service URL (default: http://localhost:5000)
AI_CHAT_URL=http://localhost:5000
AI_CHAT_PORT=5000
