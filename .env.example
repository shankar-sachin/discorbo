# Discord Bot Configuration
# Copy this file to .env and fill in your actual values

# Your bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Your application/client ID from the Discord Developer Portal
CLIENT_ID=your_application_id_here

# Your development server ID (for testing commands)
GUILD_ID=your_dev_server_id_here

# Your Discord user ID (for owner-only commands)
OWNER_ID=your_discord_user_id_here
